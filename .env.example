# Public server URLs
NEXTAUTH_URL=http://localhost:3000
POCKETBASE_URL=http://127.0.0.1:8090

# Host / Docker exposed ports
PORT=3000
POCKETBASE_PORT=8090

# Google / Auth.js
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=

# PocketBase server-only access. Prefer a nonrenewable superuser token.
POCKETBASE_SUPERUSER_TOKEN=
# Optional fallback for local development when a token is not configured.
POCKETBASE_SUPERUSER_EMAIL=
POCKETBASE_SUPERUSER_PASSWORD=

# Telegram application credentials from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# 32 random bytes encoded as base64: openssl rand -base64 32
TELEGRAM_SESSION_ENCRYPTION_KEY=
TELEGRAM_SESSION_KEY_VERSION=1

# Worker controls
TELEGRAM_SEND_CONCURRENCY=1
TELEGRAM_SEND_DELAY_MS=1200
TELEGRAM_WORKER_POLL_MS=1500
TELEGRAM_MAX_PHOTO_BYTES=10485760
TELEGRAM_MAX_VIDEO_BYTES=52428800
